<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\test.runsettings</RunSettingsFilePath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../AnoMech/AnoMech.csproj" />
  </ItemGroup>

  <!-- The plugin references these with Private=false because Dalamud supplies them in game; the
       test host has no Dalamud, so they're copied next to the tests instead. -->
  <ItemGroup>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)Dalamud.dll" Private="true" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)Dalamud.Bindings.ImGui.dll" Private="true" />
    <Reference Include="Dalamud.Bindings.ImPlot" HintPath="$(DalamudLibPath)Dalamud.Bindings.ImPlot.dll" Private="true" />
    <Reference Include="Dalamud.Bindings.ImGuizmo" HintPath="$(DalamudLibPath)Dalamud.Bindings.ImGuizmo.dll" Private="true" />
    <Reference Include="FFXIVClientStructs" HintPath="$(DalamudLibPath)FFXIVClientStructs.dll" Private="true" />
    <Reference Include="InteropGenerator.Runtime" HintPath="$(DalamudLibPath)InteropGenerator.Runtime.dll" Private="true" />
    <Reference Include="Newtonsoft.Json" HintPath="$(DalamudLibPath)Newtonsoft.Json.dll" Private="true" />
    <Reference Include="Lumina" HintPath="$(DalamudLibPath)Lumina.dll" Private="true" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudLibPath)Lumina.Excel.dll" Private="true" />
    <Reference Include="Serilog" HintPath="$(DalamudLibPath)Serilog.dll" Private="true" />
    <Reference Include="Microsoft.Extensions.ObjectPool" HintPath="$(DalamudLibPath)Microsoft.Extensions.ObjectPool.dll" Private="true" />
  </ItemGroup>

  <!-- Real sheet data for DataminingGameData, from xivapi/ffxiv-datamining at a pinned commit. Each
       commit gets its own cache folder, so the network is only touched after a bump or a new sheet.
       Downloads land in partial/ first so an interrupted fetch is never mistaken for a cached file. -->
  <PropertyGroup>
    <DataminingCommit>d9582a624eaec69d45649366dee801c2f3a6e9b3</DataminingCommit>
    <DataminingDir>$(BaseIntermediateOutputPath)datamining\$(DataminingCommit)\</DataminingDir>
  </PropertyGroup>

  <ItemGroup>
    <DataminingSheet Include="Action;BNpcBase;BNpcName;ClassJob;Condition;ContentFinderCondition;Knockback;ModelChara;ModelSkeleton;Omen;Status;TerritoryType;Weather" />
  </ItemGroup>

  <Target Name="DownloadDataminingSheets" BeforeTargets="BeforeBuild">
    <DownloadFile SourceUrl="https://raw.githubusercontent.com/xivapi/ffxiv-datamining/$(DataminingCommit)/csv/en/%(DataminingSheet.Identity).csv"
                  DestinationFolder="$(DataminingDir)partial\"
                  Retries="3"
                  Condition="!Exists('$(DataminingDir)%(DataminingSheet.Identity).csv')" />
    <Move SourceFiles="$(DataminingDir)partial\%(DataminingSheet.Identity).csv"
          DestinationFolder="$(DataminingDir)"
          Condition="!Exists('$(DataminingDir)%(DataminingSheet.Identity).csv')" />
    <ItemGroup>
      <None Include="$(DataminingDir)%(DataminingSheet.Identity).csv"
            Link="datamining\%(DataminingSheet.Identity).csv"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
