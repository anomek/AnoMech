<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Authors>Anomek</Authors>
    <Version>0.4.2.0</Version>
    <Description>Simulate ultimate raid mechanics solo client-side</Description>
    <RootNamespace>AnoMech</RootNamespace>
    <PackageProjectUrl>https://github.com/anomek/AnoMech</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/RelayWire.cs" Link="Multiplayer/RelayWire.cs" />
    <EmbeddedResource Include="../images/icon.png" LogicalName="AnoMech.OfflineIcon.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <PackageReference Include="NVorbis" Version="0.10.5" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <EmbeddedResource Include="$(PkgNAudio_Core)/lib/netstandard2.0/NAudio.Core.dll" LogicalName="AnoMech.Embedded.NAudio.Core.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgNAudio_WinMM)/lib/netstandard2.0/NAudio.WinMM.dll" LogicalName="AnoMech.Embedded.NAudio.WinMM.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgNVorbis)/lib/netstandard2.0/NVorbis.dll" LogicalName="AnoMech.Embedded.NVorbis.dll" Visible="false" />
  </ItemGroup>
</Project>
